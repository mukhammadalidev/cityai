# Django (backend/config/settings.py ildizdan .env o‘qiydi)
DJANGO_SECRET_KEY=o‘zgartiring
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (ixtiyoriy, vergul bilan)
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Telegram bot (aiogram)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# OpenAI (marketing / AI — ixtiyoriy)
# OPENAI_API_KEY=

# Frontend (Vite — envDir: loyiha ildizi)
VITE_API_BASE_URL=http://localhost:8000
VITE_TELEGRAM_BOT_URL=https://t.me/citybotuz_bot

# Telegram Web App: faqat HTTPS (telefonda localhost ishlamaydi).
# ngrok: `npm run tunnel:ngrok` (frontend papkada) yoki `ngrok http 5173`
# Keyin TELEGRAM_WEB_APP_URL ga chiqgan https://....ngrok-free.app (path va oxirgi / siz).
# Tunnel hostname HMR uchun (Vite): subdomain xuddi shu bo‘lsin, masalan:
# VITE_TUNNEL_HMR_HOST=xxxx.ngrok-free.app
#
# Oq sahifa / ERR_NGROK_6024: ngrok bepul rejada brauzer ogohlantirishi. «Visit Site» bosing;
# yoki reklama bloklovchi cdn.ngrok.com ni to‘sib qo‘ymasin; yoki ngrok pullik reja.
# Muqobil: `brew install cloudflare/cloudflare/cloudflared` → `npm run tunnel:cf` (ogohlantirish kamroq).
# TELEGRAM_WEB_APP_URL=https://xxxx.ngrok-free.app
# VITE_TELEGRAM_WEB_APP_URL=https://xxxx.ngrok-free.app

# Hikvision FaceID / turniket (LAN). Parolni koddaga yozmang.
# HIKVISION_IP=192.168.1.10
# HIKVISION_USERNAME=admin
# HIKVISION_PASSWORD=
# DJANGO_ATTENDANCE_API_URL=http://127.0.0.1:8000/api/attendance/hikvision/event/
# HIKVISION_BELONG_GROUP=1
# HIKVISION_DOOR_RIGHT=1
# HIKVISION_DOOR_NO=1
# HIKVISION_PLAN_TEMPLATE_NO=1
# HIKVISION_WEBHOOK_SECRET=
# Listener: hodisa XML ni to'liqroq logga chiqarish (0/1)
# HIKVISION_DEBUG_EVENTS=1
