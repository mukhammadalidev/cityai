# Eski: loyiha ildizidagi .env — faqat lokal Vite uchun.
# Docker: deploy/stack.env (cp deploy/stack.env.example deploy/stack.env)
#
# Docker Compose ildizdagi .env ni ham o‘qiydi; kalitda $ bo‘lsa xato chiqadi — openssl rand -hex 32 ishlating.

# Majburiy (production)
DJANGO_SECRET_KEY=ozgartiring-uzun-tasodifiy-qator
# Vergul bilan: example.com,www.example.com yoki *
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,frontend,backend

# CORS: brauzerdan ochiladigan to‘liq URL (vergul bilan)
# Masalan: https://sizning-domen.uz
CORS_ALLOWED_ORIGINS=https://sizning-domen.uz

# Django admin login (HTTPS domen, vergul bilan)
# CSRF_TRUSTED_ORIGINS=https://sizning-domen.uz

# Brauzer frontend (odatda bo‘sh — bir xil domen orqali /api)
# Docker buildda VITE_USE_RELATIVE_API=1

# AI / Telegram (ixtiyoriy)
# OPENAI_API_KEY=
# TELEGRAM_BOT_TOKEN=

# Tashqi port: host nginx deploy/nginx-citybot.uz.conf bilan mos — docker-compose.yml da "127.0.0.1:8080:80".
