# Nusxa: cp deploy/images.env.example deploy/images.env
# Keyin: docker-compose -f docker-compose.images.yml --env-file deploy/images.env pull
#       docker-compose -f docker-compose.images.yml --env-file deploy/images.env up -d
#
# Rasmlarni oldindan registryga yuboring (GitHub Actions, boshqa mashina yoki kuchli laptop):
#   docker build -t ghcr.io/USERNAME/cityai-backend:1.0.0 ./backend
#   docker push ghcr.io/USERNAME/cityai-backend:1.0.0
#   (frontend xuddi shu)

CITYAI_BACKEND_IMAGE=ghcr.io/USERNAME/cityai-backend:latest
CITYAI_FRONTEND_IMAGE=ghcr.io/USERNAME/cityai-frontend:latest
