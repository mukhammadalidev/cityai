# VPSda avtomatik: bash deploy/bootstrap-stack-env.sh
# Yoki qo‘lda: cp deploy/stack.env.example deploy/stack.env && nano deploy/stack.env
#
# MUHIM: Docker Compose loyiha ildizidagi ".env" faylini ham o‘qiydi.
# Agar ildizda .env bo‘lsa va ichida $ belgisi bo‘lsa — xato yoki ogohlantirishlar chiqadi.
# Yechim: DJANGO_SECRET_KEY uchun faqat harf-raqam (masalan: openssl rand -hex 32)
# yoki ildizdagi .env ni vaqtincha boshqacha nomlang: mv .env .env.vite

DJANGO_SECRET_KEY=ozgartiring-openssl-rand-hex-32-ishlating
# IP orqali kirilsa, shu IP ni ham qo‘shing — aks holda API 400 (DisallowedHost).
DJANGO_ALLOWED_HOSTS=citybot.uz,www.citybot.uz,YOUR_VPS_IP,localhost,127.0.0.1,frontend,backend
# SPA http://IP dan ochilsa, shu http://IP ni ham yozing (DEBUG=0 da CORS).
CORS_ALLOWED_ORIGINS=https://citybot.uz,http://YOUR_VPS_IP
CSRF_TRUSTED_ORIGINS=https://citybot.uz,http://YOUR_VPS_IP

# OPENAI_API_KEY=
# TELEGRAM_BOT_TOKEN=
